{
  "name": "mochi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --port 3000",
    "postinstall": "pnpm cf:typegen",
    "build": "NODE_ENV=production vite build",
    "preview": "vite preview --port 3000",
    "check": "biome check . && pnpm typecheck",
    "format": "biome format --write .",
    "lint:fix": "biome lint --write .",
    "typecheck": "pnpm cf:typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "cf:typegen": "wrangler types",
    "build:production": "CLOUDFLARE_ENV=production pnpm build",
    "deploy": "pnpm build:production && pnpm db:migrate:production && wrangler deploy",
    "db:migrate:production": "wrangler d1 migrations apply DB --remote --env production"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "better-auth": "1.7.18",
    "drizzle-orm": "^0.45.4",
    "hast-util-to-html": "^9.0.6",
    "hast-util-to-jsx-runtime": "^2.3.7",
    "image-size": "^2.0.4",
    "mdast-util-to-hast": "^13.2.1",
    "picscrub": "^1.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@testing-library/react": "^16.3.3",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
