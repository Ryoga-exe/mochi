{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      "src/*": ["./src/*"]
    }
  },
  "include": ["src", "tests", "*.ts", "worker-configuration.d.ts"]
}
