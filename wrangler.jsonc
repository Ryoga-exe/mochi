{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mochi-local",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": { "PUBLIC_OWNER_NAME": "Ryoga" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mochi",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [{ "binding": "ASSETS_BUCKET", "bucket_name": "mochi-assets" }],
  "env": {
    "production": {
      "name": "mochi",
      "routes": [{ "pattern": "mochi.ryoga.dev", "custom_domain": true }],
      "vars": {
        "BETTER_AUTH_URL": "https://mochi.ryoga.dev",
        "PUBLIC_OWNER_NAME": "Ryoga"
      },
      "secrets": {
        "required": ["BETTER_AUTH_SECRET", "GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET", "ADMIN_GITHUB_ID"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mochi",
          "database_id": "d6c5ef28-0c98-4d1e-be94-cc89eb1bb023",
          "migrations_dir": "drizzle"
        }
      ],
      "r2_buckets": [{ "binding": "ASSETS_BUCKET", "bucket_name": "mochi-assets" }]
    }
  }
}
